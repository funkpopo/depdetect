{
  "publisher": "funkpopo",
  "name": "depdetect",
  "displayName": "DepDetect",
  "version": "0.1.5",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "Detects and manages dependencies versions in projects.",
  "author": "funkpopo",
  "license": "MIT",
  "homepage": "https://github.com/funkpopo/dep-packages#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/funkpopo/dep-packages"
  },
  "bugs": {
    "url": "https://github.com/funkpopo/dep-packages/issues"
  },
  "keywords": [
    "node",
    "npm",
    "go",
    "golang",
    "java",
    "maven",
    "javascript",
    "json"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "res/logo.png",
  "engines": {
    "node": ">=22.18.0",
    "vscode": "1.101.0"
  },
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/requirements.txt",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/pom.xml",
    "onCommand:depdetect.replaceVersion",
    "onCommand:depdetect.retry"
  ],
  "contributes": {
    "commands": [
      {
        "command": "depdetect.replaceVersion",
        "title": "Do not call manually ! Replace Version of the provided dependency",
        "category": "🎈 DepDetect"
      },
      {
        "command": "depdetect.retry",
        "title": "Retry to fetch the active dependency file",
        "category": "🎈 DepDetect"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DepDetect",
      "properties": {
        "depdetect.errorDecorator": {
          "type": "string",
          "scope": "resource",
          "default": "❗️",
          "description": "The text to show when a dependency has errors."
        },
        "depdetect.incompatibleDecorator": {
          "type": "string",
          "scope": "resource",
          "default": "❌ ${version}",
          "description": "The text template to show when a dependency is not semver compatible. ${version} will be replaced by the latest version info."
        },
        "depdetect.compatibleDecorator": {
          "type": "string",
          "scope": "resource",
          "default": "✅",
          "description": "The text template to show when a dependency is semver compatible. ${version} will be replaced by the latest version info."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup --external vscode",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "vscode:prepublish": "npm run build",
    "publish": "vsce publish",
    "pack": "vsce package --no-dependencies",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && pnpm run publish"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/npm-registry-fetch": "8.0.9",
    "@types/semver": "7.8.0",
    "@types/vscode": "1.101.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vscode/vsce": "3.9.2",
    "bumpp": "12.2.1",
    "eslint": "10.8.1",
    "npm-registry-fetch": "19.1.1",
    "p-limit": "7.3.1",
    "semver": "7.8.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
